generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum RoleName { SUPER_ADMIN BRANCH_MANAGER CUSTOMER_SERVICE SALES_MANAGER ACCOUNTANT TECHNICIAN CUSTOMER }
enum OrderStatus { NEW UNDER_REVIEW ASSIGNED IN_PROGRESS COMPLETED CANCELLED }
enum OrderType { PRODUCT_PURCHASE INSTALLATION MAINTENANCE INSPECTION MAINTENANCE_CONTRACT }
enum ContractType { MONTHLY QUARTERLY ANNUAL }
model Branch { id String @id @default(cuid()) name String address String? users User[] customers Customer[] devices Device[] orders Order[] inventory Inventory[] createdAt DateTime @default(now()) @@index([name]) }
model User { id String @id @default(cuid()) name String email String @unique phone String? passwordHash String role RoleName branchId String? branch Branch? @relation(fields:[branchId],references:[id]) technician Technician? auditLogs AuditLog[] createdAt DateTime @default(now()) @@index([role,branchId]) }
model Customer { id String @id @default(cuid()) name String phone String email String? address String? branchId String? branch Branch? @relation(fields:[branchId],references:[id]) devices Device[] orders Order[] contracts Contract[] invoices Invoice[] createdAt DateTime @default(now()) @@index([phone]) }
model Device { id String @id @default(cuid()) brand String model String capacity String? serialNumber String @unique installationDate DateTime? warrantyStatus String? customerId String customer Customer @relation(fields:[customerId],references:[id]) branchId String? branch Branch? @relation(fields:[branchId],references:[id]) maintenance MaintenanceRecord[] }
model Technician { id String @id @default(cuid()) userId String @unique user User @relation(fields:[userId],references:[id]) specialty String assignedJobs Order[] performanceScore Float @default(0) }
model Service { id String @id @default(cuid()) slug String @unique title String description String orders Order[] }
model Order { id String @id @default(cuid()) type OrderType status OrderStatus @default(NEW) description String? location String? preferredDate DateTime? customerId String? customer Customer? @relation(fields:[customerId],references:[id]) branchId String? branch Branch? @relation(fields:[branchId],references:[id]) serviceId String? service Service? @relation(fields:[serviceId],references:[id]) technicianId String? technician Technician? @relation(fields:[technicianId],references:[id]) invoice Invoice? createdAt DateTime @default(now()) @@index([status,type,branchId]) }
model MaintenanceRecord { id String @id @default(cuid()) deviceId String device Device @relation(fields:[deviceId],references:[id]) serviceDate DateTime problemDescription String technicianName String? partsReplaced String? notes String? photosBefore String[] photosAfter String[] createdAt DateTime @default(now()) }
model Contract { id String @id @default(cuid()) type ContractType customerId String customer Customer @relation(fields:[customerId],references:[id]) startDate DateTime endDate DateTime visits Int status String contractVisits ContractVisit[] createdAt DateTime @default(now()) @@index([endDate,status]) }
model ContractVisit { id String @id @default(cuid()) contractId String contract Contract @relation(fields:[contractId],references:[id]) visitDate DateTime status String notes String? }
model Invoice { id String @id @default(cuid()) number String @unique customerId String? customer Customer? @relation(fields:[customerId],references:[id]) orderId String? @unique order Order? @relation(fields:[orderId],references:[id]) total Decimal @db.Decimal(12,2) status String payments Payment[] createdAt DateTime @default(now()) }
model Payment { id String @id @default(cuid()) invoiceId String invoice Invoice @relation(fields:[invoiceId],references:[id]) method String amount Decimal @db.Decimal(12,2) paidAt DateTime @default(now()) }
model Category { id String @id @default(cuid()) name String products Product[] }
model Product { id String @id @default(cuid()) name String brand String? specs Json? stockQuantity Int @default(0) categoryId String? category Category? @relation(fields:[categoryId],references:[id]) inventory Inventory[] @@index([name,brand]) }
model Inventory { id String @id @default(cuid()) productId String product Product @relation(fields:[productId],references:[id]) branchId String branch Branch @relation(fields:[branchId],references:[id]) quantity Int lowStockThreshold Int @default(5) movements StockMovement[] @@unique([productId,branchId]) }
model StockMovement { id String @id @default(cuid()) inventoryId String inventory Inventory @relation(fields:[inventoryId],references:[id]) quantity Int reason String createdAt DateTime @default(now()) }
model Supplier { id String @id @default(cuid()) name String phone String? email String? productsSupplied String? purchaseInvoices Json? payments Json? }
model Coupon { id String @id @default(cuid()) code String @unique discount Decimal @db.Decimal(8,2) expiresAt DateTime usageLimit Int usedCount Int @default(0) }
model Notification { id String @id @default(cuid()) channel String recipient String title String body String sendAt DateTime sentAt DateTime? }
model FileAsset { id String @id @default(cuid()) type String url String mimeType String size Int ownerType String ownerId String createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()) userId String? user User? @relation(fields:[userId],references:[id]) action String entity String entityId String? ip String? createdAt DateTime @default(now()) @@index([entity,createdAt]) }
